{
  "id": "com.pavan.bitchord.spotiflac.multisource",
  "name": "SpotiFLAC Multi-Source Lossless",
  "version": "0.7.0",
  "resources": [
    "search",
    "stream"
  ],
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "lossless",
      "options": [
        {
          "label": "Hi-Res Lossless",
          "value": "lossless"
        },
        {
          "label": "Hi-Res",
          "value": "high"
        },
        {
          "label": "Lossless",
          "value": "low"
        }
      ]
    }
  ],
  "bitchordAuth": true,
  "allowDownloads": false
}
